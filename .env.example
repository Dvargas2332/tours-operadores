# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Auth (login interno) ───────────────────────────────────────
ADMIN_USER=               # Usuario para iniciar sesión (dev: admin)
ADMIN_PASSWORD=           # Contraseña del usuario admin (dev: tourhub)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL/Supabase connection string (postgresql://user:pass@host:5432/db)
